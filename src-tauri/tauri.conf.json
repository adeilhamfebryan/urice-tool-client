{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "URice Tools Client",
    "version":  "0.1.2",
    "identifier":  "com.urice.tools.client",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "URice Tools Client",
                                    "width":  1280,
                                    "height":  820,
                                    "minWidth":  1024,
                                    "minHeight":  700
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "externalBin":  [
                                       "../backend/dist/urice-engine"
                                   ],
                   "createUpdaterArtifacts":  true,
                   "windows":  {
                                   "nsis":  {
                                                "displayLanguageSelector":  false,
                                                "installMode":  "perMachine",
                                                "installerIcon":  "icons/icon.ico"
                                            }
                               },
                   "icon":  [
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "updater":  {
                                    "active":  true,
                                    "endpoints":  [
                                                      "https://github.com/adeilhamfebryan/urice-tool-client/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                },
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMTUwQzdCNUE1RDE0OTEKUldTUkZGMWFld3dWSDkvcEJXQ2xBaVFjendvbzZWYmdjbG9LWENrZW1PaENubUdZbjFzTUQ3V0oK"
                                }
                }
}
